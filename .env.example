# TEN Capital -- Venture Exit Scenario Analyzer
# Copy to .env and fill in. Every variable is optional; the application runs
# fully without them, using deterministic parsing and a local outbox.

# --- Claude API ------------------------------------------------------------
# Enables AI-assisted gap-filling extraction and narrative prose. Without a key
# the application uses deterministic parsing only and no number changes.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5
CLAUDE_ENABLED=true
CLAUDE_MAX_TOKENS=4096
CLAUDE_TIMEOUT_SECONDS=120

# --- Result emails (Resend) ------------------------------------------------
# Every generated report is emailed to EMAIL_TO with the PDF and JSON attached.
# Without a key, delivery is skipped and the application runs normally.
# The EMAIL_FROM domain must be verified in the Resend dashboard.
RESEND_API_KEY=
EMAIL_FROM=TEN Capital Exit Analyzer <exit-analyzer@tencapital.group>
EMAIL_TO=Info@tencapital.group
EMAIL_ENABLED=true
EMAIL_AUTO_SEND=true
# Require share_with_ten_capital consent in addition to analysis_consent.
EMAIL_REQUIRE_SHARE_CONSENT=false
EMAIL_TIMEOUT_SECONDS=30

# --- TEN Capital record transmission ---------------------------------------
# Endpoint that accepts the structured analysis record. When unset, records are
# written to ./outbox instead of being sent anywhere.
TEN_CAPITAL_API_URL=
TEN_CAPITAL_API_KEY=
TEN_CAPITAL_TIMEOUT_SECONDS=30
